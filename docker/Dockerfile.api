FROM python:3.12-slim-bookworm
RUN useradd --create-home --uid 10001 venera \
    && mkdir -p /run/venera && chown venera:venera /run/venera
WORKDIR /opt/venera
COPY docker/api_server.py docker/ipc_client.py ./
COPY LICENSE ./
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    VENERA_WORKER_SOCKET=/run/venera/worker.sock \
    VENERA_API_TOKEN_FILE=/run/secrets/api_token \
    VENERA_API_HOST=0.0.0.0 VENERA_API_PORT=8080
USER 10001:10001
EXPOSE 8080
STOPSIGNAL SIGTERM
ENTRYPOINT ["python3", "/opt/venera/api_server.py"]
